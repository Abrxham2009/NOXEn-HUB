.ic.star.on{color:#fbbf24}.ic.star.on svg{fill:#fbbf24}
.empty{padding:50px 20px;text-align:center;color:var(--mu);border:1px dashed var(--line);border-radius:var(--r)}
.empty .btn{margin-top:16px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.chip{padding:8px 16px;border-radius:99px;border:1px solid var(--line);color:var(--mu);font-size:.85rem;transition:.2s}
.chip:hover{color:var(--tx)}
.chip.on{background:var(--ac);border-color:var(--ac);color:var(--onac)}
.panel{max-width:620px;padding:22px;border-radius:var(--r);background:var(--card);border:1px solid var(--line);margin-bottom:18px}
.panel h4{font-weight:600;margin-bottom:6px}
.panel p{color:var(--mu);font-size:.85rem;margin-bottom:16px;line-height:1.5}
.row{display:flex;gap:10px;flex-wrap:wrap}
.sw{width:38px;height:38px;border-radius:50%;border:2px solid transparent;transition:transform .2s}
.sw:hover{transform:scale(1.12)}
.sw.on{border-color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.15)}
dialog{margin:auto;border:1px solid var(--line);border-radius:22px;background:var(--bg2);color:var(--tx);padding:26px;width:min(440px,92vw);box-shadow:0 40px 100px -20px #000}
dialog::backdrop{background:rgba(5,6,10,.7);backdrop-filter:blur(4px)}
dialog[open]{animation:pop .25s cubic-bezier(.2,.8,.2,1)}
@keyframes pop{from{opacity:0;transform:scale(.95) translateY(8px)}}
dialog h2{font-size:1.2rem;margin-bottom:18px}
label{display:block;font-size:.8rem;color:var(--mu);margin:14px 0 6px}
input.f,select.f{width:100%;height:44px;padding:0 14px;border-radius:12px;background:var(--card);border:1px solid var(--line);color:var(--tx);font:inherit;font-size:.9rem;outline:0}
input.f:focus,select.f:focus{border-color:var(--ac)}
select.f option{background:var(--bg2)}
.dfoot{display:flex;gap:10px;justify-content:flex-end;margin-top:22px}
.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);padding:12px 20px;border-radius:14px;background:var(--bg2);border:1px solid var(--line);opacity:0;pointer-events:none;transition:.3s;z-index:9;font-size:.88rem}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media(max-width:760px){
body{flex-direction:column-reverse}
.sidebar{width:100%;height:auto;flex-direction:row;align-items:center;padding:8px 10px;border-right:0;border-top:1px solid var(--line);gap:0;justify-content:space-between}
.logo,.side-foot{display:none}
nav{flex-direction:row;width:100%;justify-content:space-around}
.nav{flex-direction:column;gap:4px;font-size:.62rem;padding:7px 6px;text-align:center}
.nav.on::before{display:none}
.search{min-width:0;flex:1 1 100%;order:3}
.mlogo{display:flex!important}
.grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
.acts{opacity:1}
