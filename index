.card:hover .acts,.card:focus-within .acts,.acts.fav-on{opacity:1}
.ic{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;color:var(--mu)}
.ic:hover{background:var(--hov);color:var(--tx)}
