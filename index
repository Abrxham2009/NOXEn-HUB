<style>
:root{--sb:#0a0b10;--hov:rgba(255,255,255,.08);--tagtx:#cbbcff;--onac:#fff;--bgi:none;--bgs:auto;--bg:#0c0d12;--bg2:#13141b;--card:rgba(255,255,255,.04);--line:rgba(255,255,255,.08);--tx:#eceef6;--mu:#8b8fa3;--ac:#8b5cf6;--ac2:#3b82f6;--r:18px;--side:240px}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Sora',system-ui,-apple-system,'Segoe UI',sans-serif;background:var(--bg);color:var(--tx);display:flex;overflow:hidden;
background-image:var(--bgi);background-size:var(--bgs)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
