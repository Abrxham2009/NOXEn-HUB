.sidebar,main{position:relative;z-index:1}
#deco{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0}
#deco span{position:absolute;opacity:.17;animation:fl 9s ease-in-out infinite alternate}
@keyframes fl{to{transform:translateY(-24px) rotate(12deg)}}
.themes{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}
.th{padding:12px;border-radius:14px;border:2px solid var(--line);text-align:left;font-size:.82rem;display:flex;flex-direction:column;gap:10px;transition:transform .2s,border-color .2s}
.th:hover{transform:translateY(-2px)}
.th.on{border-color:var(--ac);box-shadow:0 0 0 3px color-mix(in srgb,var(--ac) 25%,transparent)}
.th i{display:block;height:26px;border-radius:8px}
body:not(.admin) .adm,body:not(.admin) #add{display:none}
.mlogo{display:none;align-items:center;gap:10px;font-weight:700;margin-right:auto}
.mlogo img{width:30px;height:30px;object-fit:contain}
@media(max-width:760px){header h1{display:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
