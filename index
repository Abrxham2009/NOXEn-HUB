.btn{height:44px;padding:0 20px;border-radius:14px;font-weight:600;font-size:.9rem;background:linear-gradient(135deg,var(--ac),var(--ac2));color:var(--onac);box-shadow:0 8px 24px -8px var(--ac);transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px -8px var(--ac)}
.btn.ghost{background:var(--card);border:1px solid var(--line);box-shadow:none;color:var(--tx)}
.btn.danger{color:#ff7a8a}
.hello{margin-bottom:34px}
.hello h2{font-size:clamp(1.8rem,4vw,2.8rem);font-weight:700;letter-spacing:-.02em;line-height:1.15;animation:rise .7s cubic-bezier(.2,.8,.2,1) both}
.hello p{margin-top:10px;color:var(--mu);animation:rise .7s .1s cubic-bezier(.2,.8,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(14px)}}
h3{font-size:1rem;font-weight:600;margin:30px 0 14px;display:flex;align-items:center;gap:10px}
h3 small{color:var(--mu);font-weight:400}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px}
.card{position:relative;padding:18px;border-radius:var(--r);background:var(--card);border:1px solid var(--line);box-shadow:0 10px 30px -18px rgba(0,0,0,.8);cursor:pointer;transition:transform .25s,border-color .25s,background .25s;display:flex;flex-direction:column;gap:14px;text-align:left}
.card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--ac) 55%,transparent);background:var(--hov)}
.tile{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-weight:700;font-size:1.25rem;color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}
.card .nm{font-weight:600;font-size:.98rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .ur{font-size:.78rem;color:var(--mu);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}
.tag{align-self:flex-start;font-size:.72rem;padding:4px 10px;border-radius:99px;background:color-mix(in srgb,var(--ac) 16%,transparent);color:var(--tagtx)}
