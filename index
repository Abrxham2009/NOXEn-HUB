.nav.on::before{content:"";position:absolute;left:-16px;top:10px;bottom:10px;width:3px;border-radius:3px;background:var(--ac)}
.side-foot{margin-top:auto;font-size:.75rem;color:var(--mu);padding:0 8px}
main{flex:1;min-width:0;height:100%;overflow-y:auto;padding:28px clamp(18px,4vw,48px) 60px}
