nav{display:flex;flex-direction:column;gap:4px}
.nav{display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:12px;color:var(--mu);font-size:.9rem;text-align:left;transition:background .2s,color .2s;position:relative}
