 set('--tagtx',light?`color-mix(in srgb,${ac} 80%,#000)`:`color-mix(in srgb,${ac} 55%,#fff)`);
 set('--onac',(L(ac)+L(ac2))/2>.55?'#0b0b12':'#fff');
 let bi=`radial-gradient(800px 500px at 85% -10%,color-mix(in srgb,${ac} ${light?14:18}%,transparent),transparent),radial-gradient(600px 400px at 0% 100%,color-mix(in srgb,${ac2} ${light?12:14}%,transparent),transparent)`,bs='auto,auto';
 if(stars){const pts=[[30,40,1.4],[110,200,1],[190,90,1.8],[250,250,1.2],[70,140,1],[160,20,1.2],[280,160,1.5]];
  const lay=(z,k)=>pts.map(p=>`radial-gradient(${p[2]*k}px ${p[2]*k}px at ${p[0]*z/300}px ${p[1]*z/300}px,#fff,transparent)`);
  bi+=','+[...lay(300,1),...lay(470,.9)].join(',');bs+=','+[...pts.map(()=>'300px 300px'),...pts.map(()=>'470px 470px')].join(',')}
 set('--bgi',bi);set('--bgs',bs);
 const list=deco.split(' ').filter(Boolean);
 $('#deco').innerHTML=list.length?Array.from({length:16},(_,i)=>`<span style="left:${(i*47+13)%96}%;top:${(i*29+7)%90}%;font-size:${18+(i*7)%18}px;animation-duration:${7+(i%5)*2}s;animation-delay:-${(i*1.3).toFixed(1)}s">${list[i%list.length]}</span>`).join(''):'';
}

function renderNav(){$('#nav').innerHTML=SECTIONS.map(s=>`<button class="nav ${view===s[0]?'on':''}" data-v="${s[0]}" ${view===s[0]?'aria-current="page"':''}>${svg(I[s[2]])}<span>${innerW()<=760?(SHORT[s[0]]||s[1]):s[1]}</span></button>`).join('')}
const innerW=()=>window.innerWidth;
function card(a){
 const h=hue(a.name);
 return `<div class="card" tabindex="0" role="link" data-open="${a.id}" aria-label="Abrir ${esc(a.name)}">
  <div class="acts ${isFav(a)?'fav-on':''}">
   <button class="ic star ${isFav(a)?'on':''}" data-fav="${a.id}" aria-label="Favorita" title="Favorita">${svg(I.star)}</button>
   <button class="ic adm" data-edit="${a.id}" aria-label="Editar" title="Editar">${svg(I.edit)}</button>
   <button class="ic adm" data-del="${a.id}" aria-label="Eliminar" title="Eliminar">${svg(I.trash)}</button>
  </div>
  <div class="tile" style="background:linear-gradient(135deg,hsl(${h} 70% 55%),hsl(${(h+50)%360} 70% 45%))">${esc(a.name[0].toUpperCase())}</div>
  <div><div class="nm">${esc(a.name)}</div><div class="ur">${esc(host(a.url))}</div></div>
  <span class="tag">${esc(a.cat||'Sin categoría')}</span></div>`}
function grid(list,msg){return list.length?`<div class="grid">${list.map(card).join('')}</div>`:`<div class="empty">${msg}</div>`}
const emptyAdd=()=>admin?'Aún no hay aplicaciones aquí.<br><button class="btn" data-addbtn>Añadir aplicación</button>':'Todavía no hay aplicaciones publicadas.';
function filtered(list){const q=$('#q').value.trim().toLowerCase();return q?list.filter(a=>(a.name+a.url+a.cat).toLowerCase().includes(q)):list}
function recents(){return S.recent.map(id=>S.apps.find(a=>a.id===id)).filter(Boolean)}

function render(){
 document.body.classList.toggle('admin',admin);
 renderNav();
 $('#title').textContent=SECTIONS.find(s=>s[0]===view)[1];
 document.title=view==='inicio'?'NOXEn HUB':SECTIONS.find(s=>s[0]===view)[1]+' · NOXEn HUB';
 const v=$('#view');const all=filtered(S.apps);
 if(view==='inicio'){
  const h=new Date().getHours(),g=h<6?'Buenas noches':h<13?'Buenos días':h<21?'Buenas tardes':'Buenas noches';
  const fav=filtered(S.apps.filter(isFav)),rec=filtered(recents()).slice(0,4);
  v.innerHTML=`<div class="hello"><h2>${g}.<br>Todo tu mundo, en un solo lugar.</h2><p>${S.apps.length} aplicaciones · ${S.apps.filter(isFav).length} favoritas</p></div>
  ${fav.length||rec.length||!all.length?`<h3>Favoritas</h3>${grid(fav.slice(0,8),'Marca una aplicación con la estrella para verla aquí.')}<h3>Abiertas recientemente</h3>${grid(rec,'Todavía no has abierto ninguna aplicación.')}`:`<h3>Aplicaciones</h3>${grid(all.slice(0,8),'')}`}`;
 }else if(view==='todas'){v.innerHTML=grid(all,S.apps.length?'Ninguna aplicación coincide con tu búsqueda.':emptyAdd())}
 else if(view==='favoritas'){v.innerHTML=grid(filtered(S.apps.filter(isFav)),'No tienes favoritas. Pulsa la estrella de una aplicación para añadirla.')}
 else if(view==='recientes'){v.innerHTML=grid(filtered(recents()),'Las aplicaciones que abras aparecerán aquí.')}
 else if(view==='categorias'){
  const cats=['Todas',...new Set(S.apps.map(a=>a.cat||'Sin categoría'))];if(!cats.includes(cat))cat='Todas';
  const list=all.filter(a=>cat==='Todas'||(a.cat||'Sin categoría')===cat);
  v.innerHTML=`<div class="chips">${cats.map(c=>`<button class="chip ${c===cat?'on':''}" data-cat="${esc(c)}">${esc(c)}</button>`).join('')}</div><h3>${esc(cat)} <small>${list.length}</small></h3>${grid(list,'No hay aplicaciones en esta categoría.')}`;
 }else{
  const own=admin?`<p>Has iniciado sesión como propietario. Lo que añadas, cambies o borres se publica solo y lo ve todo el mundo.<br><span id="st2">${esc(stText)}</span></p><div class="row"><button class="btn ghost" id="pub">Publicar ahora</button><button class="btn ghost danger" id="logout">Cerrar sesión</button></div>`
  :`<p>Todo el mundo puede ver las aplicaciones, pero solo el propietario puede añadir o cambiar. Si eres tú, inicia sesión.</p><label for="em">Correo</label><input class="f" id="em" type="email" autocomplete="username"><label for="pw">Contraseña</label><input class="f" id="pw" type="password" autocomplete="current-password"><div class="dfoot" style="justify-content:flex-start"><button class="btn" id="login">Entrar</button></div>`;
  v.innerHTML=`<div class="panel"><h4>${admin?'Propietario':'Acceso del propietario'}</h4>${own}</div><div class="panel" style="max-width:none"><h4>Tema</h4><p>${admin?'Es el tema que verá todo el mundo por defecto.':'Tu tema se guarda solo en este navegador.'}</p><div class="themes">${THEMES.map(t=>`<button class="th ${t[0]===(S.theme||'noxen')?'on':''}" data-theme="${t[0]}" style="background:${t[3]};color:${t[6]?'#1b1a2b':'#eceef6'}"><i style="background:linear-gradient(135deg,${t[4]},${t[5]})"></i>${t[2]} ${t[1]}</button>`).join('')}</div></div>
  ${admin?`<div class="panel"><h4>Copia de seguridad</h4><p>Puedes exportar un archivo con tus aplicaciones o cargar uno que ya tengas.</p><div class="row"><button class="btn ghost" id="exp">Exportar datos</button><button class="btn ghost" id="imp">Importar datos</button><input type="file" id="file" accept=".json" hidden></div></div>
  <div class="panel"><h4>Restablecer</h4><p>Borra todas tus aplicaciones, favoritas e historial, también las publicadas para todo el mundo.</p><button class="btn ghost danger" id="rst">Borrar todo</button></div>`:''}`;
 }
 $('#cats').innerHTML=[...new Set(S.apps.map(a=>a.cat).filter(Boolean))].map(c=>`<option value="${esc(c)}">`).join('');
}
async function doLogin(){
 const em=$('#em').value.trim(),pw=$('#pw').value;
 if(!em||!pw)return toast('Escribe tu correo y contraseña');
 try{await login(em,pw);const d=await pull();
  if(d)applyRemote(d);else{if(!S.apps.length)S.apps=[{id:'estudio',name:'Mi espacio de estudio',url:'estudio.html',cat:'Estudio',fav:true}];save()}
  setSt(mode());applyAccent();render();toast('Sesión iniciada')}
 catch(x){const m=x.message||'';toast(/NOT_ALLOWED/.test(m)?'Activa el acceso con correo en Firebase':/INVALID|NOT_FOUND|PASSWORD|CREDENTIAL/.test(m)?'Correo o contraseña incorrectos':'No pude iniciar sesión')}}
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.id==='pw')doLogin()});
function go(v){view=v;history.replaceState(null,'','#'+v);$('#main').scrollTop=0;render()}

function openDlg(id){
 editing=id;const a=S.apps.find(x=>x.id===id)||{name:'',url:'',cat:''};
 $('#dt').textContent=id?'Editar aplicación':'Nueva aplicación';
 $('#fn').value=a.name;$('#fu').value=a.url;$('#fc').value=a.cat||'';
 $('#dlg').showModal();$('#fn').focus()}
function normUrl(u){u=u.trim();if(/^https?:\/\//i.test(u)||/^\.{1,2}\//.test(u)||/^[^\/:]+\.html?$/i.test(u))return u;return 'https://'+u}

document.addEventListener('click',e=>{
 const t=e.target.closest('button,[data-open]');if(!t)return;
 if(t.dataset.v)return go(t.dataset.v);
 if(t.id==='login')return doLogin();
 if(t.id==='logout'){S.rt='';admin=false;idTok='';exp=0;save0();setSt(mode());render();return toast('Sesión cerrada')}
 if(t.id==='pub'){save();return toast('Publicando…')}
 if((t.id==='add'||t.dataset.addbtn!==undefined)&&admin)return openDlg(null);
 if(t.dataset.fav){const a=S.apps.find(x=>x.id===t.dataset.fav);if(admin){a.fav=!a.fav;save()}else{S.vfav=S.vfav.includes(a.id)?S.vfav.filter(i=>i!==a.id):[...S.vfav,a.id];save0()}render();return toast(isFav(a)?'Añadida a favoritas':'Quitada de favoritas')}
 if(t.dataset.edit)return admin&&openDlg(t.dataset.edit);
 if(t.dataset.del){if(!admin)return;const a=S.apps.find(x=>x.id===t.dataset.del);if(confirm('¿Eliminar “'+a.name+'”?')){S.apps=S.apps.filter(x=>x!==a);S.recent=S.recent.filter(i=>i!==a.id);save();render();toast('Aplicación eliminada')}return}
 if(t.dataset.cat){cat=t.dataset.cat;return render()}
 if(t.dataset.theme){S.theme=t.dataset.theme;if(admin)save();else{S.themeSet=true;save0()}applyAccent();render();return toast('Tema: '+THEMES.find(x=>x[0]===S.theme)[1])}
 if(t.dataset.acc){S.accent=+t.dataset.acc;save();applyAccent();return render()}
  if(t.id==='exp'){const b=new Blob([JSON.stringify({apps:S.apps,recent:S.recent,accent:S.accent,theme:S.theme},null,2)],{type:'application/json'});const l=document.createElement('a');l.href=URL.createObjectURL(b);l.download='noxen-hub-datos.json';l.click();return toast('Datos exportados')}
 if(t.id==='imp')return admin&&$('#file').click();
 if(t.id==='rst'){if(admin&&confirm('Se borrarán todas tus aplicaciones, también las publicadas. ¿Continuar?')){S.apps=[];S.recent=[];save();render();toast('Datos borrados')}return}
 if(t.dataset.open){const a=S.apps.find(x=>x.id===t.dataset.open);if(!a)return;S.recent=[a.id,...S.recent.filter(i=>i!==a.id)].slice(0,20);save0();window.open(normUrl(a.url),'_blank','noopener');render()}
});
document.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('[data-open]')){e.preventDefault();e.target.click()}});
document.addEventListener('change',e=>{if(e.target.id!=='file')return;const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(!Array.isArray(d.apps))throw 0;if(!admin)return;S.apps=d.apps;S.theme=d.theme||S.theme;save();applyAccent();render();toast('Datos importados')}catch(x){toast('El archivo no es válido')}};r.readAsText(f)});
$('#q').addEventListener('input',()=>{if(view==='inicio'||view==='ajustes')go('todas');else render()});
$('#cancel').onclick=()=>$('#dlg').close();
$('#form').addEventListener('submit',()=>{
 const o={name:$('#fn').value.trim(),url:normUrl($('#fu').value),cat:$('#fc').value.trim()};
 if(!admin)return;
 if(editing){Object.assign(S.apps.find(x=>x.id===editing),o);toast('Cambios guardados')}
 else{S.apps.push(Object.assign({id:'a'+Date.now(),fav:false},o));toast('Aplicación añadida')}
 save();render()});
$('#dlg').addEventListener('click',e=>{if(e.target===$('#dlg'))$('#dlg').close()});
window.addEventListener('resize',renderNav);

const LOGO=$('.logo img').src;$('.mlogo img').src=LOGO;$('link[rel=icon]').href=LOGO;
load();applyAccent();
const h=location.hash.slice(1);if(SECTIONS.some(s=>s[0]===h))view=h;
render();
(async()=>{
 if(S.rt){try{await token()}catch(e){S.rt='';admin=false;save0()}}
 setSt(mode());
 try{const d=await pull();if(d)applyRemote(d);else if(admin){if(!S.apps.length)S.apps=[{id:'estudio',name:'Mi espacio de estudio',url:'estudio.html',cat:'Estudio',fav:true}];save()}}
 catch(e){setSt('Sin conexión')}
 applyAccent();render();
})();
})();
</script>
</body>
</html>
